# ==========================================
# TogetherSpace Environment Configuration
# ==========================================

# 1. Authorized Two-User Allowlist Configuration (Required)
# Enter the exactly two email addresses allowed to use this TogetherSpace instance.
VITE_AUTHORIZED_EMAIL_1=first_authorized_user@example.com
VITE_AUTHORIZED_EMAIL_2=second_authorized_user@example.com

# 2. Firebase Web Client Configuration (Required)
# Retrieve these from: Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# 3. WebRTC TURN Server Configuration (Recommended for Symmetric NAT & Strict Firewalls)
# Free/managed providers: Metered.ca, Twilio Network Traversal, Xirsys, or Coturn.
# Standard Google STUN is enabled by default; add TURN below for 100% relay reliability.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# 4. Optional Local Firebase Emulator
# Set to 'true' if running against local Firebase emulators
VITE_USE_FIREBASE_EMULATOR=false
